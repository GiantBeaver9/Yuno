# Copy to .env for local dev, or to /etc/pi-dashboard.env on the Pi (the systemd
# unit loads it via EnvironmentFile=-/etc/pi-dashboard.env). Every value below is
# optional; uncomment and adjust what you need.

# --- Core ---

# HTTP port the dashboard listens on.
PORT=8080

# SQLite database file. On the Pi, the systemd unit's StateDirectory provides
# /var/lib/pi-dashboard, so point DB_PATH there.
DB_PATH=/var/lib/pi-dashboard/data.db

# --- Auth ---

# Enables the single-password login gate (stateless HMAC-signed session cookie,
# 30-day sliding expiry). Leave empty/commented to disable auth and rely on your
# VPN as the access boundary. If you set it, CHANGE THE VALUE below.
# APP_PASSWORD=change-me

# --- Local LLM assistant ---

# OpenAI-compatible base URL of your local LLM. Empty = assistant disabled.
#   LM Studio: http://localhost:1234/v1
#   Ollama:    http://localhost:11434/v1
# LLM_BASE_URL=http://localhost:1234/v1

# Model name for the assistant. Empty = use the server's currently loaded model
# (LM Studio behaviour). Tool calling requires a model that supports it.
# LLM_MODEL=

# --- MCP (LM Studio 0.4.0+, powers the Telegram /ask command) ---
# The bot's /ask uses LM Studio's native /api/v1/chat endpoint, which runs your
# configured MCP servers server-side. Configure the servers in LM Studio's
# mcp.json and enable "Allow calling servers from mcp.json" + "Require
# Authentication" in Server Settings.
#
# Comma-separated mcp.json server ids to enable for /ask (empty = /ask disabled).
# MCP_SERVERS=mcp/playwright,mcp/filesystem
# Bearer token for LM Studio's native endpoint (Require Authentication).
# LLM_API_TOKEN=
# LM Studio host base for /api/v1/chat. Defaults to LLM_BASE_URL without /v1.
# LLM_NATIVE_URL=http://localhost:1234

# --- Telegram bot ---

# Bot token from @BotFather. Empty = bot disabled.
# TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to use the bot. Empty = discovery mode: the
# bot only replies with the caller's chat id so you can learn it, then lock it
# down here and restart.
# TELEGRAM_ALLOWED_CHAT_IDS=

# Minutes before an event starts to push its Telegram reminder.
# REMINDER_LEAD_MINUTES=30

# Daily digest: at this local wall-clock time (24h HH:MM) the bot sends a morning
# digest — today's events (important marked), important items in the next 2 weeks,
# event countdowns, todos, per-user weather, and health alerts. It is PER-USER and
# opt-in: each person turns it on in Telegram with "/digest on" and adds weather
# locations with "/weather add <label> <lat> <lon>". Leave empty to disable entirely.
# DIGEST_TIME=06:00

# Open todos older than this many days are called out as "aging" in the digest.
# DIGEST_TODO_AGING_DAYS=7

# Health alerts: the digest flags disk/temperature only when they cross these.
# DISK_ALERT_PERCENT=90
# TEMP_ALERT_C=75

# Temperature unit for the digest weather section: celsius or fahrenheit.
# WEATHER_UNIT=celsius

# Route the assembled digest through the LLM narration hook (internal/telegram/
# digest_llm.go). Off by default; the deterministic digest is always the fallback.
# DIGEST_LLM=false
